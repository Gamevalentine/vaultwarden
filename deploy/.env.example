# Public HTTPS URL for your Vaultwarden instance.
# Example: https://vault.example.com
DOMAIN=https://vault.example.com

# Local port exposed only on the server itself.
VW_PORT=8000

# Keep true only while creating the first account, then change to false.
SIGNUPS_ALLOWED=true

# Set a long random value locally. Never commit your real token.
ADMIN_TOKEN=change-this-to-a-long-random-secret
